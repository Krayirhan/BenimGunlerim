<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup/restore policy.

    Current product decision:
    - DataStore is included because it stores settings and game progress.
    - Room database is included because it stores tasks, routines, logs, and daily states.
    - reminder_policy_cache is excluded because it is a rebuildable cache.

    This means user-created local productivity data can be included in Android
    cloud backup and device-to-device transfer. Keep the privacy policy and
    release checklist aligned with this behavior.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
        <include domain="database" path="benim_gunlerim.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
        <include domain="database" path="benim_gunlerim.db" />
    </device-transfer>
</data-extraction-rules>
